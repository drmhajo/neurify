# Copy this file to .env for local development. Never commit real values.

# Client and local API
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=

# Server authentication and ownership
VITE_APP_ID=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=
OWNER_NAME=

# Application database
DATABASE_URL=

# Supabase central registration and synchronization
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CENTRAL_SUPABASE_SERVICE_ROLE_KEY=
CENTRAL_ADMIN_PASSWORD=
REGISTRATION_APPROVAL_SECRET=

# Optional notification relay
GMAIL_RELAY_URL=
GMAIL_RELAY_TOKEN=

# Optional AI and Manus-hosted services
GEMINI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Enable only when intentionally running live integration tests
RUN_GEMINI_LIVE_TEST=false
RUN_GMAIL_RELAY_LIVE_TEST=false
RUN_CENTRAL_ADMIN_BOOTSTRAP_TEST=false
RUN_SUPABASE_CONNECTION_LIVE_TEST=false
RUN_SUPABASE_MANAGEMENT_TOKEN_TEST=false
RUN_SUPABASE_REGISTRATION_LIVE_TEST=false
SUPABASE_ACCESS_TOKEN=
